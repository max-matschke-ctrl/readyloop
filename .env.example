# Readyloop – Umgebungsvariablen (BE-12). Ohne Supabase-Variablen läuft der Demo-Modus
# (in Produktion nur mit READYLOOP_DEMO=1, siehe docs/requirements.md F-8 / Q-9).

# Supabase-Projekt (EU-Region, Gate G-3)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nur serverseitig: Einladungen (src/server/supabase/admin.ts) und I3-Systemzugriff ohne Sitzung für Erinnerungslauf,
# One-Click-Abmeldung und Webhook (src/server/supabase/system.ts, F-43). Nie mit NEXT_PUBLIC_ versehen.
SUPABASE_SERVICE_ROLE_KEY=

# Basis-URL für Links in Einladungs- und Passwort-Mails, z. B. https://app.readyloop.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo in Produktion ausdrücklich erlauben (nur ohne Supabase-Variablen wirksam)
READYLOOP_DEMO=

# ---------------------------------------------------------------- I3 E-Mail-Erinnerungen (F-36, F-37, F-40)
# Schutz der Route /api/cron/erinnerungen (≥ 32 Zeichen, zufällig). Vercel Cron sendet den Wert selbst als
# „Authorization: Bearer …“; derselbe Wert gehört in das Supabase-Vault-Secret readyloop_cron_secret (pg_cron).
CRON_SECRET=
# Resend (Senderegion EU, Gate G-6). Mailversand nur, wenn RESEND_API_KEY, MAIL_ABSENDER und MAIL_ABMELDE_SECRET
# gesetzt sind; sonst Vorschau-Modus (Demo/Entwicklung) bzw. aus (Produktion).
RESEND_API_KEY=
# Absender mit verifizierter Domain (SPF, DKIM, DMARC), z. B. Readyloop <erinnerung@mail.example.de>
MAIL_ABSENDER=
# Optional: Antwortadresse (reply_to)
MAIL_ANTWORT_AN=
# HMAC-Schlüssel der Abmeldelinks (≥ 32 Zeichen). Ein Wechsel macht alle bisherigen Abmeldelinks ungültig.
MAIL_ABMELDE_SECRET=
# Signaturgeheimnis des Resend-Webhooks (whsec_…) für /api/mail/webhook
RESEND_WEBHOOK_SECRET=
